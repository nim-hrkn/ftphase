units metal
boundary p p p
atom_style atomic
atom_modify map yes
newton on
lattice fcc 4.05
region box block 0 4 0 4 0 4
create_box 2 box
create_atoms 1 box
set type 1 type/fraction 2 0.3 12345
mass 1 26.98
mass 2 6.94
if "${style} == 1" then "pair_style mace no_domain_decomposition" "pair_coeff * * ${pot} Al Li"
if "${style} == 3" then "variable f1 equal 0.7" "variable f2 equal 0.3" "pair_style hybrid/scaled v_f1 mace no_domain_decomposition v_f2 ufm 7.5" "pair_coeff * * mace ${pot} Al Li" "pair_coeff * * ufm 0.1 1.5 7.5"
velocity all create 600.0 4928459 loop geom
fix 1 all nve
timestep 0.001
thermo 10
thermo_style custom step temp pe press cpu
run 50
