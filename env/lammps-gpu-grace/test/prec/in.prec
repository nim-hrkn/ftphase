# precision test: same random fcc Al0.7Li0.3 cell, static energy/forces for 8 configurations + 200-step NVE drift
units metal
boundary p p p
atom_style atomic
lattice fcc 4.05
region box block 0 8 0 8 0 8
create_box 2 box
create_atoms 1 box
set type 1 type/fraction 2 0.3 12345
mass 1 26.98
mass 2 6.94
pair_style ${style}
pair_coeff * * ${pot} Al Li
velocity all create 800.0 4928459 loop geom
displace_atoms all random 0.08 0.08 0.08 777
compute pe all pe/atom
thermo_style custom step pe press temp
thermo_modify format float %.8g
thermo 1
run 0
fix 1 all nve
timestep 0.002
thermo 50
run 200
dump d all custom 1 forces.${tag} id fx fy fz
dump_modify d format float %.8g sort id
run 0
