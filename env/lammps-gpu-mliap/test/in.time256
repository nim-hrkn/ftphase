# 256-atom fcc Al0.7Li0.3 timing cell (same as env/lammps-torch/test/in.mace); ${pre} = pair_style line, ${pc} = pair_coeff line
units metal
boundary p p p
atom_style atomic
atom_modify map yes
newton on
lattice fcc 4.05
region box block 0 4 0 4 0 4
create_box 2 box
create_atoms 1 box
set type 1 type/fraction 2 0.3 12345
mass 1 26.98
mass 2 6.94
${pre}
${pc}
velocity all create 600.0 4928459 loop geom
fix 1 all nve
timestep 0.001
thermo_style custom step pe press
run 20
run 100
